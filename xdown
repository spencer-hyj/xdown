#!/bin/sh
# xdown 启动器：确保能找到 uv 安装的 yt-dlp，并跟随符号链接找到 xdown.py
set -e

# 解析自身真实路径（支持 ~/.local/bin/xdown 软链接）
self="$0"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in
    /*) self="$target" ;;
    *)  self="$(dirname "$self")/$target" ;;
  esac
done
here="$(cd "$(dirname "$self")" && pwd)"

PATH="$HOME/.local/bin:/opt/local/bin:/usr/local/bin:$PATH"
export PATH

exec python3 "$here/xdown.py" "$@"